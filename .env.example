EDUGRADE_ENV=development
EDUGRADE_SERVICE_NAME=api-gateway
EDUGRADE_HTTP_HOST=127.0.0.1
EDUGRADE_HTTP_PORT=8080
EDUGRADE_LOG_LEVEL=info
EDUGRADE_READINESS_TIMEOUT=2s
EDUGRADE_SHUTDOWN_TIMEOUT=10s
EDUGRADE_SESSION_TTL=8h
EDUGRADE_LOGIN_FAILURE_LIMIT=5
EDUGRADE_LOGIN_FAILURE_WINDOW=15m
EDUGRADE_SESSION_COOKIE_NAME=edugrade_session
EDUGRADE_SESSION_COOKIE_SECURE=false
EDUGRADE_HTTP_MAX_HEADER_BYTES=1048576
EDUGRADE_MAX_REQUEST_BODY_BYTES=2097152
EDUGRADE_HTTP_READ_HEADER_TIMEOUT=5s
EDUGRADE_HTTP_READ_TIMEOUT=15s
EDUGRADE_HTTP_WRITE_TIMEOUT=780s
EDUGRADE_HTTP_IDLE_TIMEOUT=60s
EDUGRADE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5180,http://localhost:5173,http://localhost:5174,http://localhost:5180
EDUGRADE_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EDUGRADE_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Trace-ID,Idempotency-Key,X-EduGrade-CSRF

EDUGRADE_POSTGRES_DB=edugrade
EDUGRADE_POSTGRES_USER=edugrade
EDUGRADE_POSTGRES_PASSWORD=edugrade_dev
EDUGRADE_POSTGRES_DSN=postgres://edugrade:edugrade_dev@127.0.0.1:5432/edugrade?sslmode=disable

EDUGRADE_REDIS_ADDR=127.0.0.1:6379
EDUGRADE_REDIS_PASSWORD=
EDUGRADE_REDIS_DB=0

EDUGRADE_MINIO_ENDPOINT=127.0.0.1:9000
EDUGRADE_MINIO_ACCESS_KEY=edugrade
EDUGRADE_MINIO_SECRET_KEY=edugrade_dev_secret
EDUGRADE_MINIO_USE_SSL=false
EDUGRADE_FILE_BUCKET=edugrade-files
EDUGRADE_FILE_MAX_UPLOAD_BYTES=104857600
EDUGRADE_FILE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.csv,.docx
EDUGRADE_BARCODE_ACTIVE_KEY_ID=local-v1
EDUGRADE_BARCODE_HMAC_KEYS=local-v1:replace_with_at_least_32_random_characters

EDUGRADE_QDRANT_HTTP_PORT=6333
EDUGRADE_QDRANT_URL=
EDUGRADE_QDRANT_API_KEY=
EDUGRADE_AI_SERVICE_URL=
EDUGRADE_AI_SERVICE_TOKEN=replace_with_at_least_32_random_characters
EDUGRADE_AI_SERVICE_TIMEOUT=750s
EDUGRADE_AI_SERVICE_MAX_RETRIES=0
EDUGRADE_AI_MODEL_VERSION=Qwen/Qwen3-4B-GGUF:Q4_K_M
EDUGRADE_AI_PROMPT_VERSION=subjective-local-structured-v2
EDUGRADE_AI_MIN_CONFIDENCE=0.8
EDUGRADE_GRADING_MODEL_BASE_URL=http://host.docker.internal:8087/v1
EDUGRADE_GRADING_MODEL_API_KEY=
EDUGRADE_SLOW_REQUEST_THRESHOLD=2s

# One-time operational bootstrap. Set password only when running:
# go run ./cmd/api-gateway bootstrap-admin
EDUGRADE_BOOTSTRAP_TENANT_CODE=platform
EDUGRADE_BOOTSTRAP_ROLE_CODE=platform_admin
EDUGRADE_BOOTSTRAP_USERNAME=platform_admin
EDUGRADE_BOOTSTRAP_DISPLAY_NAME=Platform Admin
EDUGRADE_BOOTSTRAP_PASSWORD=

EDUGRADE_IMAGE_QUALITY_TENANT_CODE=demo
EDUGRADE_IMAGE_QUALITY_USERNAME=
EDUGRADE_IMAGE_QUALITY_PASSWORD=
EDUGRADE_IMAGE_QUALITY_BATCH_SIZE=1
EDUGRADE_IMAGE_QUALITY_LEASE_SECONDS=300
EDUGRADE_IMAGE_QUALITY_POLL_INTERVAL=5
EDUGRADE_IMAGE_QUALITY_WORKER_ID=image-quality-worker-1
EDUGRADE_OCR_LEASE_SECONDS=300
