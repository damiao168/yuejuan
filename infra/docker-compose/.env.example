EDUGRADE_ENV=local
EDUGRADE_IMAGE_TAG=local
EDUGRADE_APP_VERSION=dev
EDUGRADE_GIT_SHA=unknown
EDUGRADE_BUILD_TIME=unknown
EDUGRADE_IMAGE_DIGEST=unknown
EDUGRADE_RELEASE_ID=local
EDUGRADE_SCHEMA_VERSION=000099
EDUGRADE_MIGRATION_BASELINE_VERSION=
EDUGRADE_LOG_LEVEL=info
EDUGRADE_READINESS_TIMEOUT=2s
EDUGRADE_SHUTDOWN_TIMEOUT=10s
EDUGRADE_SESSION_TTL=8h
EDUGRADE_REMEMBERED_SESSION_TTL=720h
EDUGRADE_LOGIN_FAILURE_LIMIT=5
EDUGRADE_LOGIN_FAILURE_WINDOW=15m
EDUGRADE_SESSION_COOKIE_NAME=edugrade_session
EDUGRADE_SESSION_COOKIE_SECURE=false
EDUGRADE_HTTP_MAX_HEADER_BYTES=1048576
EDUGRADE_MAX_REQUEST_BODY_BYTES=2097152
EDUGRADE_HTTP_READ_HEADER_TIMEOUT=5s
EDUGRADE_HTTP_READ_TIMEOUT=15s
EDUGRADE_HTTP_WRITE_TIMEOUT=780s
EDUGRADE_HTTP_IDLE_TIMEOUT=60s
EDUGRADE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5180,http://localhost:5180
EDUGRADE_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EDUGRADE_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Trace-ID,Idempotency-Key,X-EduGrade-CSRF
EDUGRADE_TRUSTED_PROXY_CIDRS=

EDUGRADE_NGINX_HTTP_PORT=8088
EDUGRADE_API_PORT=8080
EDUGRADE_WEB_API_BASE_URL=

# Internal service ports (postgres/redis/minio/qdrant/api/prometheus/grafana)
# bind to loopback by default so only nginx is reachable from other machines.
# Override with 0.0.0.0 only on an isolated development host.
EDUGRADE_INTERNAL_BIND_HOST=127.0.0.1
EDUGRADE_CONTAINER_LOG_MAX_SIZE=10m
EDUGRADE_CONTAINER_LOG_MAX_FILES=5

# Per-service memory ceilings so a runaway worker cannot take down the
# database on a shared host. Raise these to match the deployment hardware.
EDUGRADE_POSTGRES_MEM_LIMIT=2g
EDUGRADE_REDIS_MEM_LIMIT=512m
EDUGRADE_MINIO_MEM_LIMIT=1g
EDUGRADE_QDRANT_MEM_LIMIT=2g
EDUGRADE_API_MEM_LIMIT=1g
EDUGRADE_GRADING_AGENT_MEM_LIMIT=2g
EDUGRADE_OCR_WORKER_MEM_LIMIT=4g
EDUGRADE_IMAGE_QUALITY_MEM_LIMIT=2g
# page-processing validates the PDF pixel budget before rendering, then keeps
# permitted page images in memory while preparing the document. Size this
# ceiling for EDUGRADE_PAGE_PROCESSING_MAX_TOTAL_PIXELS and lower that budget
# first on smaller hosts.
EDUGRADE_PAGE_PROCESSING_MEM_LIMIT=8g

EDUGRADE_POSTGRES_DB=edugrade
EDUGRADE_POSTGRES_USER=edugrade
EDUGRADE_POSTGRES_PASSWORD=change_me_postgres_demo
EDUGRADE_POSTGRES_PORT=5432
EDUGRADE_POSTGRES_DSN=postgres://edugrade:change_me_postgres_demo@postgres:5432/edugrade?sslmode=disable
EDUGRADE_POSTGRES_MAX_OPEN_CONNS=10
EDUGRADE_POSTGRES_MAX_IDLE_CONNS=5
EDUGRADE_POSTGRES_CONN_MAX_LIFETIME=30m
EDUGRADE_POSTGRES_CONN_MAX_IDLE_TIME=5m
EDUGRADE_POSTGRES_STATEMENT_TIMEOUT=60s
EDUGRADE_POSTGRES_LOCK_TIMEOUT=5s

EDUGRADE_REDIS_PASSWORD=change_me_redis_demo
EDUGRADE_REDIS_PORT=6379
EDUGRADE_REDIS_DB=0

EDUGRADE_MINIO_ACCESS_KEY=edugrade
EDUGRADE_MINIO_SECRET_KEY=change_me_minio_demo_secret
EDUGRADE_MINIO_API_PORT=9000
EDUGRADE_MINIO_CONSOLE_PORT=9001
EDUGRADE_FILE_BUCKET=edugrade-files
EDUGRADE_FILE_MAX_UPLOAD_BYTES=104857600
EDUGRADE_FILE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.csv,.docx
EDUGRADE_FILE_RECONCILIATION_INTERVAL=24h
EDUGRADE_FILE_RECONCILIATION_STALE_AFTER=1h
EDUGRADE_FILE_RECONCILIATION_BATCH_SIZE=200
EDUGRADE_FILE_RECONCILIATION_OBJECT_LIMIT=1000
EDUGRADE_BARCODE_ACTIVE_KEY_ID=local-v1
EDUGRADE_BARCODE_HMAC_KEYS=local-v1:replace_with_at_least_32_random_characters

EDUGRADE_QDRANT_HTTP_PORT=6333
EDUGRADE_QDRANT_GRPC_PORT=6334
EDUGRADE_QDRANT_URL=http://qdrant:6333
EDUGRADE_QDRANT_API_KEY=change_me_qdrant_demo_key_32_chars_min

EDUGRADE_AI_SERVICE_URL=http://grading-agent:8100
EDUGRADE_AI_GRADING_ENABLED=true
EDUGRADE_ALLOW_MOCK_AI=false
EDUGRADE_AI_SERVICE_TOKEN=replace_with_at_least_32_random_characters
EDUGRADE_AI_SERVICE_TIMEOUT=750s
EDUGRADE_AI_SERVICE_MAX_RETRIES=0
EDUGRADE_AI_MODEL_VERSION=Qwen/Qwen3-4B-GGUF:Q4_K_M
EDUGRADE_AI_PROMPT_VERSION=subjective-governed-structured-v3
EDUGRADE_AI_MIN_CONFIDENCE=0.8
EDUGRADE_AI_PROVIDER_KEY=local
EDUGRADE_AI_DEPLOYMENT_KEY=local-qwen3-4b-q4-k-m
EDUGRADE_AI_ADAPTER_TYPE=local_llama_cpp
EDUGRADE_AI_DEPLOYMENT_REGION=on_premise
EDUGRADE_AI_CAPABILITY_PROFILE=local-pilot-v1
EDUGRADE_GRADING_MODEL_BASE_URL=http://host.docker.internal:8087/v1
EDUGRADE_GRADING_MODEL_API_KEY=
EDUGRADE_GRADING_MODEL_NAME=qwen3-4b-q4-k-m
EDUGRADE_GRADING_MODEL_TIMEOUT_SECONDS=360
EDUGRADE_GRADING_MODEL_READY_TIMEOUT_SECONDS=3
EDUGRADE_GRADING_MODEL_QUEUE_TIMEOUT_SECONDS=5
EDUGRADE_GRADING_MODEL_MAX_RETRIES=1
EDUGRADE_GRADING_MODEL_MAX_OUTPUT_TOKENS=512
EDUGRADE_SLOW_REQUEST_THRESHOLD=2s
EDUGRADE_WORKER_HEARTBEAT_STALE_AFTER=30s

EDUGRADE_OCR_INSTALL_PADDLEOCR=true
EDUGRADE_PYPI_INDEX_URL=https://pypi.org/simple
EDUGRADE_DEBIAN_MIRROR=http://deb.debian.org/debian
EDUGRADE_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
EDUGRADE_OCR_WORKER_TENANT_CODE=platform
EDUGRADE_OCR_WORKER_USERNAME=ocr_worker
EDUGRADE_OCR_WORKER_PASSWORD=
EDUGRADE_OCR_ENGINE=paddleocr
EDUGRADE_OCR_ENGINE_VERSION=pp-ocrv5
EDUGRADE_OCR_MODEL_VERSION=ppocr-v5-server
EDUGRADE_OCR_MIN_CONFIDENCE=0.8
EDUGRADE_OCR_POLL_INTERVAL=5
EDUGRADE_OCR_BATCH_SIZE=1
EDUGRADE_OCR_DEVICE=cpu
EDUGRADE_OCR_PREPROCESS_PROFILE=default
EDUGRADE_OCR_WORKER_ID=ocr-worker-1
EDUGRADE_OCR_LEASE_SECONDS=300
EDUGRADE_OCR_HEARTBEAT_INTERVAL=10
EDUGRADE_OCR_HEARTBEAT_TIMEOUT=3

EDUGRADE_IMAGE_QUALITY_TENANT_CODE=platform
EDUGRADE_IMAGE_QUALITY_USERNAME=image_quality_worker
EDUGRADE_IMAGE_QUALITY_PASSWORD=
EDUGRADE_IMAGE_QUALITY_BATCH_SIZE=1
EDUGRADE_IMAGE_QUALITY_LEASE_SECONDS=300
EDUGRADE_IMAGE_QUALITY_POLL_INTERVAL=5
EDUGRADE_IMAGE_QUALITY_WORKER_ID=image-quality-worker-1

EDUGRADE_PAGE_PROCESSING_TENANT_CODE=platform
EDUGRADE_PAGE_PROCESSING_USERNAME=page_processing_worker
EDUGRADE_PAGE_PROCESSING_PASSWORD=
EDUGRADE_PAGE_PROCESSING_BATCH_SIZE=1
EDUGRADE_PAGE_PROCESSING_LEASE_SECONDS=600
EDUGRADE_PAGE_PROCESSING_POLL_INTERVAL=4
EDUGRADE_PAGE_PROCESSING_MAX_PAGES=500
EDUGRADE_PAGE_PROCESSING_MAX_PAGE_PIXELS=50000000
EDUGRADE_PAGE_PROCESSING_MAX_TOTAL_PIXELS=1000000000
EDUGRADE_PAGE_PROCESSING_WORKER_ID=page-processing-worker-1
EDUGRADE_PAGE_PROCESSING_HEARTBEAT_INTERVAL=30
EDUGRADE_PAGE_PROCESSING_HEARTBEAT_TIMEOUT=10

EDUGRADE_SUBJECTIVE_WORKER_TENANT_CODE=platform
EDUGRADE_SUBJECTIVE_WORKER_USERNAME=subjective_grading_worker
EDUGRADE_SUBJECTIVE_WORKER_PASSWORD=
EDUGRADE_SUBJECTIVE_WORKER_ID=subjective-grading-worker-1
EDUGRADE_SUBJECTIVE_WORKER_POLL_INTERVAL=5
EDUGRADE_SUBJECTIVE_WORKER_LEASE_SECONDS=300
EDUGRADE_SUBJECTIVE_WORKER_HEARTBEAT_INTERVAL=10
EDUGRADE_SUBJECTIVE_WORKER_HEARTBEAT_TIMEOUT=3
EDUGRADE_SUBJECTIVE_WORKER_HEALTH_MAX_AGE=120

EDUGRADE_MATH_VERIFY_TIMEOUT_SECONDS=3
EDUGRADE_MATH_VERIFY_MEM_LIMIT=1g

EDUGRADE_PROMETHEUS_PORT=9090
EDUGRADE_GRAFANA_PORT=3000
EDUGRADE_GRAFANA_ADMIN_USER=admin
EDUGRADE_GRAFANA_ADMIN_PASSWORD=change_me_grafana_demo

# One-time operational bootstrap. Keep password out of committed env files in real deployments.
EDUGRADE_BOOTSTRAP_TENANT_CODE=platform
EDUGRADE_BOOTSTRAP_ROLE_CODE=platform_admin
EDUGRADE_BOOTSTRAP_USERNAME=platform_admin
EDUGRADE_BOOTSTRAP_DISPLAY_NAME=Platform Admin
EDUGRADE_BOOTSTRAP_PASSWORD=

# Optional base-image overrides for private registries or offline image mirrors.
EDUGRADE_GO_BUILD_IMAGE=golang:1.26.6-alpine
EDUGRADE_API_RUNTIME_IMAGE=alpine:3.22
EDUGRADE_NODE_BUILD_IMAGE=node:24-alpine
EDUGRADE_WEB_RUNTIME_IMAGE=nginx:1.29-alpine
EDUGRADE_AI_PYTHON_IMAGE=python:3.12.13-alpine3.24
EDUGRADE_OCR_PYTHON_IMAGE=python:3.11.15-slim-trixie
EDUGRADE_QUALITY_PYTHON_IMAGE=python:3.11.15-slim-trixie
EDUGRADE_PAGE_PROCESSING_PYTHON_IMAGE=python:3.11.15-slim-trixie
EDUGRADE_MATH_PYTHON_IMAGE=python:3.11.15-slim-trixie

# Set to true only once when adopting migration tracking for an existing verified schema.
