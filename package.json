{
  "name": "edugrade-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web-admin run dev",
    "build": "npm --workspaces --if-present run build",
    "check:story049": "node scripts/check-story049-ocr-worker.mjs",
    "check:story050": "node scripts/check-story050-image-quality.mjs",
    "check:story051": "node scripts/check-story051-agent-worker-runtime.mjs",
    "check:story052": "node scripts/check-story052-production-deployment.mjs",
    "check:story053": "node scripts/check-story053-product-shell.mjs",
    "check:story057": "node scripts/check-story057-grading-contract.mjs",
    "check:story061": "node scripts/check-story061-model-evaluation-ui.mjs",
    "check:story063": "node scripts/check-story063-subjective-grading.mjs",
    "lab:test": "npm --prefix lab test",
    "lab:eval": "npm --prefix lab run eval",
    "lab:gate:dev": "npm --prefix lab run gate:dev",
    "check:lab-integration": "node scripts/check-lab-integration.mjs",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "preview": "npm --workspace apps/web-admin run preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report output/playwright/report"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
