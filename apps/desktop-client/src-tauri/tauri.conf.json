{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduGrade Desktop Client",
  "version": "0.1.0",
  "identifier": "com.edugrade.enterprise.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EduGrade Enterprise Client",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "EduGrade Enterprise Windows client",
    "longDescription": "EduGrade Enterprise Windows desktop client skeleton for scan upload, offline review, synchronization and diagnostics."
  }
}
